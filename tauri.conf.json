{
  "productName": "piclr",
  "version": "0.1.0",
  "identifier": "com.piclr",
  "build": {
    "frontendDist": "tauri-dist",
    "devUrl": "http://localhost"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "piclr",
        "transparent": true,
        "backgroundColor": [0, 0, 0, 0],
        "decorations": false,
        "width": 1200,
        "height": 800
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
